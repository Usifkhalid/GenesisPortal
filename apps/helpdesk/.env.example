# The IT Helpdesk's settings. Copy to apps/helpdesk/.env and fill in. .env is
# never committed. The portal has its own: apps/portal/.env.example. Every
# variable the portal knows works here too, under the same rules; this file
# lists the ones a developer sets.

# 3001 beside the portal's 3000.
PORT=3001

# The helpdesk's own database on the same SQL Server as the portal's.
# HELPDESK_DATA=live switches to mghelpdesk_live; tests use mghelpdesk_test.
# A password containing ; = { } or spaces must be wrapped in braces.
DATABASE_URL="sqlserver://localhost:1433;database=mghelpdesk;user=sa;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"

# Optional. The test database; must be named *_test. Absent: DATABASE_URL with
# _test added (mghelpdesk_test). Set it when HELPDESK_DATA=live.
# DATABASE_URL_TEST="sqlserver://localhost:1433;database=mghelpdesk_test;user=sa;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"

# Signs the session cookie (mgh.sid, apart from the portal's mgp.sid). Any long
# random string, at least 32 characters in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# The helpdesk's public origin. <APP_BASE_URL>/auth/callback must be a redirect
# URI on the app registration (http://localhost:3001/auth/callback already is).
# Defaults to http://localhost:<PORT>; required (https) in production.
# APP_BASE_URL=https://helpdesk.example.com

# Optional. The portal's address, for the small "Back to portal" link in the
# header. Absent: no link.
# PORTAL_URL=http://localhost:3000

# mock = the login screen lists seeded fake people (development only).
# entra = Microsoft sign-in, with the ENTRA_* values below.
AUTH_MODE=mock

# Mail through Microsoft Graph (the bell is always on). mock = written to
# apps/helpdesk/backend/mock/outbox/, listed at #dev/outbox. real = sent from
# NOREPLY_MAILBOX, which needs Mail.Send. (GRAPH_MODE is the same switch.)
GRAPH_MAIL_MODE=mock

# People from Microsoft 365 (npm run sync:users, and nightly at 02:00 Cairo).
# real = the tenant's directory with the app's own token (User.Read.All,
# Application, admin consent). Absent: follows GRAPH_MAIL_MODE.
# GRAPH_DIRECTORY_MODE=mock

# demo = DATABASE_URL as written, fake people (npm run db:seed).
# live = <name>_live (mghelpdesk_live): only real people. Needs
#        AUTH_MODE=entra and GRAPH_DIRECTORY_MODE=real.
HELPDESK_DATA=demo

# The mailbox the helpdesk's email is sent from.
NOREPLY_MAILBOX=no-reply@mgholding.example

# Entra ID: the same app registration as the portal (MGH-Portal-Web). Needed
# when AUTH_MODE=entra or a Graph mode is real.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=CHANGE_ME

# Optional. Emails made the helpdesk's administrator (HoldingAdmin here) at
# their first Microsoft sign-in, only while no real one exists. Audited.
# INITIAL_HELPDESK_ADMINS=first.admin@mgholding.example

# Optional. Ticket attachments: apps/helpdesk/storage by default (local).
# Production: STORAGE_DRIVER=azure with its own container, SCAN_MODE=defender.
# STORAGE_DIR=./storage
# STORAGE_DRIVER=local
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=helpdesk-files
# SCAN_MODE=mock

# Optional, as in the portal: LOG_LEVEL, TRUST_PROXY_HOPS, RATE_LIMIT_*,
# AUTH_RATE_LIMIT_*, SESSION_IDLE_MINUTES, SESSION_ABSOLUTE_HOURS,
# SESSION_SECRET_PREVIOUS, SERVICE_WORKER, STATIC_PRECOMPRESS,
# APPLICATIONINSIGHTS_CONNECTION_STRING, SHUTDOWN_GRACE_MS.
# Production refuses to start with anything mocked or a demo database.
