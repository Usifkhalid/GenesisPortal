# Copy to .env and fill in. .env is never committed.

PORT=3000

# SQL Server. Local Developer edition in dev, Azure SQL in production.
# encrypt=true is required by Azure SQL; trustServerCertificate=true suits a
# local instance using a self-signed certificate.
# A password containing ; = { } or spaces must be wrapped in braces:
# password={my;pass}. A literal } inside it is written }}.
DATABASE_URL="sqlserver://localhost:1433;database=mgportal;user=sa;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"

# Optional. The database `npm test` and `npm run test:e2e` run on; they empty it
# before every run and never touch DATABASE_URL. Must be named *_test. Absent:
# DATABASE_URL with `_test` added to its database name (mgportal_test).
# DATABASE_URL_TEST="sqlserver://localhost:1433;database=mgportal_test;user=sa;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"

# Optional. pino level: fatal, error, warn, info, debug, trace or silent.
# Defaults to debug in development, info in production, silent under test.
# LOG_LEVEL=debug

# Optional. Requests per IP: across /api, and the stricter cap on /api/auth.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20

# Signs the server-side session cookie. Any long random string; at least 16
# characters. Generate one with: node -e "console.log(crypto.randomUUID())"
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# The portal's own public origin. Entra redirect URIs are built from it:
# <APP_BASE_URL>/auth/callback must be registered on the app registration.
# Defaults to http://localhost:<PORT>; required in production.
# APP_BASE_URL=https://portal.example.com

# mock = the login screen lists seeded fake users per company and role.
# Mock sign-in only answers when NODE_ENV=development.
# entra = real Entra ID sign-in, which needs the ENTRA_* values below.
AUTH_MODE=mock

# Optional. Folder for uploaded files such as company logos (local storage
# adapter). Defaults to <repo>/storage, which is gitignored and not served.
# STORAGE_DIR=./storage

# mock = canned Microsoft Graph responses. real = the live tenant.
GRAPH_MODE=mock

# Entra ID app registration in the "mgholding" tenant. Only needed when
# AUTH_MODE=entra or GRAPH_MODE=real. Access is not granted yet.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=CHANGE_ME
