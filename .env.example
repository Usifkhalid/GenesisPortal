# Copy to .env and fill in. .env is never committed.

PORT=3000

# SQL Server. Local Developer edition in dev, Azure SQL in production.
# encrypt=true is required by Azure SQL; trustServerCertificate=true suits a
# local instance using a self-signed certificate.
# A password containing ; = { } or spaces must be wrapped in braces:
# password={my;pass}. A literal } inside it is written }}.
DATABASE_URL="sqlserver://localhost:1433;database=mgportal;user=sa;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"

# Optional. The database `npm test` and `npm run test:e2e` run on; they empty it
# before every run and never touch DATABASE_URL. Must be named *_test. Absent:
# DATABASE_URL with `_test` added to its database name (mgportal_test).
# DATABASE_URL_TEST="sqlserver://localhost:1433;database=mgportal_test;user=sa;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"

# Optional. pino level: fatal, error, warn, info, debug, trace or silent.
# Defaults to debug in development, info in production, silent under test.
# LOG_LEVEL=debug

# Optional. Reverse proxies between the internet and this process. Azure App
# Service is 1 (the default); 2 if Azure Front Door is put in front of it; 0
# when nothing is. The client address is read that many hops back and no
# further, so a forged X-Forwarded-For is ignored.
# TRUST_PROXY_HOPS=1

# Optional. Requests per client address across /api.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300
# Optional. Sign-in attempts per window (15 minutes): 10 per account, and a
# much higher ceiling per address because all of HQ shares one public address.
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_ACCOUNT_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_MAX=600

# Signs the server-side session cookie. Any long random string; at least 16
# characters (32 in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING
# Optional, during a rotation: the secret before this one. Cookies signed with
# it stay valid; remove it once SESSION_ABSOLUTE_HOURS have passed.
# SESSION_SECRET_PREVIOUS=

# Optional. A session ends after this long unused, and this long after sign-in
# however active it is.
# SESSION_IDLE_MINUTES=480
# SESSION_ABSOLUTE_HOURS=12

# The portal's own public origin. Entra redirect URIs are built from it:
# <APP_BASE_URL>/auth/callback must be registered on the app registration.
# Defaults to http://localhost:<PORT>; required in production.
# APP_BASE_URL=https://portal.example.com

# mock = the login screen lists seeded fake users per company and role.
# Mock sign-in only answers when NODE_ENV=development.
# entra = real Entra ID sign-in, which needs the ENTRA_* values below.
AUTH_MODE=mock

# Optional. Folder for uploaded files such as company logos (local storage
# adapter). Defaults to <repo>/storage, which is gitignored and not served.
# STORAGE_DIR=./storage

# Where uploads live. local = the folder above (development). azure = one
# private Azure Blob container, reached with the app's managed identity;
# required in production. See docs/DEPLOY.md.
# STORAGE_DRIVER=local
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=portal-files
# Only for Azurite on a developer's machine, instead of the two above:
# AZURE_STORAGE_CONNECTION_STRING=

# Who says an upload is free of malware before it can be downloaded.
# mock = a local stand-in (everything is clean except the EICAR test file).
# defender = Microsoft Defender for Storage; needs STORAGE_DRIVER=azure and is
# required in production.
# SCAN_MODE=mock

# Optional. Application Insights. Absent: no telemetry is collected or sent.
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional. How long a stopping process waits for requests in flight.
# SHUTDOWN_GRACE_MS=10000

# Offline worker and precompressed static files. Both default to on in
# production and off in development, where they would hide every file edit.
# SERVICE_WORKER=on
# STATIC_PRECOMPRESS=on

# mock = canned Microsoft Graph responses. real = the live tenant.
# Production refuses to start with anything mocked: AUTH_MODE=mock,
# GRAPH_MODE=mock, SCAN_MODE=mock, STORAGE_DRIVER=local, a CHANGE_ME value, an
# http:// APP_BASE_URL, or (on Azure App Service) a NODE_ENV other than production.
GRAPH_MODE=mock

# The mailbox portal email is sent from (Graph sendMail). Mock mode writes
# mail to backend/mock/outbox/ instead; the dev page #dev/outbox lists it.
NOREPLY_MAILBOX=no-reply@mgholding.example

# Entra ID app registration in the "mgholding" tenant. Only needed when
# AUTH_MODE=entra or GRAPH_MODE=real. Access is not granted yet.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=CHANGE_ME

# Optional. Comma-separated emails made HoldingAdmin when they sign in with
# Entra, only while no active HoldingAdmin with a real Entra account exists
# (seeded stand-ins do not count). Every grant is audited. Once the first real
# HoldingAdmin exists this does nothing and can be removed.
# INITIAL_HOLDING_ADMINS=first.admin@mgholding.example
