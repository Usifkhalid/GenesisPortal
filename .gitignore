node_modules/
.env
*.log
.DS_Store

# Generated Prisma clients (the helpdesk's is generated into its app folder).
apps/*/backend/generated/
apps/*/backend/prisma/*.db

# Uploaded files: the local storage adapter (packages/shared/server/lib/storage.js).
# The portal's are in <repo>/storage, the helpdesk's in apps/helpdesk/storage.
storage/

# Mail the mocked Graph "sent" (integrations/graph/mock-mail.js), per app.
apps/*/backend/mock/outbox/

# Test and tooling output.
coverage/
playwright-report/
test-results/

# Transient Impeccable session artifacts; design.json is kept.
.impeccable/questions/
.impeccable/mocks/

# Review screenshots are regenerated on every critique.
.impeccable/review/

# Local project briefing, not for the repository.
portal-project-context.md

# Tool-made copy of CLAUDE.md for other coding agents; CLAUDE.md is the one source.
AGENTS.md

# HR personal data (staff lists, hand matches) and import reports: never committed.
private/
reports/
