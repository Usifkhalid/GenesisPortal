{
  "name": "mg-holding",
  "version": "0.1.0",
  "private": true,
  "description": "MG Holding: the employee portal and the IT Helpdesk, two apps with shared packages.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @mg/portal",
    "dev:helpdesk": "npm run dev -w @mg/helpdesk",
    "test": "npm test -w @mg/portal && npm test -w @mg/helpdesk",
    "test:portal": "npm test -w @mg/portal",
    "test:helpdesk": "npm test -w @mg/helpdesk",
    "test:e2e": "npm run test:e2e -w @mg/portal",
    "test:e2e:helpdesk": "npm run test:e2e -w @mg/helpdesk",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate -w @mg/portal --",
    "db:deploy": "npm run db:deploy -w @mg/portal --",
    "db:generate": "npm run db:generate -w @mg/portal --",
    "db:seed": "npm run db:seed -w @mg/portal --",
    "db:reset": "npm run db:reset -w @mg/portal --",
    "db:live:setup": "npm run db:live:setup -w @mg/portal --",
    "sync:users": "npm run sync:users -w @mg/portal --",
    "import:hr": "npm run import:hr -w @mg/portal --",
    "helpdesk:db:deploy": "npm run db:deploy -w @mg/helpdesk --",
    "helpdesk:db:generate": "npm run db:generate -w @mg/helpdesk --",
    "helpdesk:db:seed": "npm run db:seed -w @mg/helpdesk --",
    "helpdesk:db:reset": "npm run db:reset -w @mg/helpdesk --",
    "helpdesk:db:setup-live": "npm run db:setup-live -w @mg/helpdesk --",
    "helpdesk:sync:users": "npm run sync:users -w @mg/helpdesk --",
    "helpdesk:import:hr": "npm run import:hr -w @mg/helpdesk --"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
