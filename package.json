{
  "name": "mg-holding-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Internal employee portal for MG Holding and its companies.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch backend/src/server.js",
    "start": "node backend/src/server.js",
    "pretest": "node backend/scripts/prepare-test-db.js",
    "test": "node --test \"backend/tests/**/*.test.js\"",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "db:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "db:deploy": "node backend/scripts/migrate-deploy.js",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:seed": "node backend/prisma/seed.js",
    "db:reset": "node backend/scripts/reset-db.js",
    "db:live:setup": "node backend/scripts/setup-live-db.js",
    "sync:users": "node backend/scripts/sync-users.js"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/msal-node": "^7.0.1",
    "@azure/storage-blob": "^12.34.0",
    "@prisma/client": "^6.1.0",
    "applicationinsights": "^3.17.0",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
